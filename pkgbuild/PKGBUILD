# Maintainer: Anthony Serritella

pkgname=leaf
pkgver=0.1.0
pkgrel=1
pkgdesc='Markdown viewer for reading and navigating long Markdown files, built with Qt Quick'
arch=('x86_64')
url='https://github.com/pantherdev2024/leaf'
license=('MIT')
install='leaf.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/leaf "$pkgdir/usr/bin/leaf"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/leaf.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/leaf.svg"
  /usr/bin/install -Dm644 "$startdir/leaf.desktop" "$pkgdir/usr/share/applications/leaf.desktop"
}
