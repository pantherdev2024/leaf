#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "makepkg is required to build and install the Arch package." >&2
  exit 1
fi

"$ROOT/bin/build"

cd "$PKGBUILD_DIR"
makepkg -fsi "$@"

# Omawrite is the Markdown default only because nothing else claims Markdown, so
# record Leaf explicitly in the user's own settings. A failure here leaves Leaf
# installed; it can still be set as the default by hand.
if xdg-mime default leaf.desktop text/markdown text/x-markdown \
    && [ "$(xdg-mime query default text/markdown)" = "leaf.desktop" ]; then
  echo "Leaf is now the default app for Markdown files."
else
  echo "Leaf is installed, but could not be made the default for Markdown files." >&2
  echo "Set it by hand with: xdg-mime default leaf.desktop text/markdown text/x-markdown" >&2
fi
